{"uid":"llm-slo","title":"LLM Gateway - SLO Status","schemaVersion":41,"refresh":"30s","time":{"from":"now-7d","to":"now"},"panels":[
{"id":1,"type":"stat","title":"Availability (30d)","gridPos":{"x":0,"y":0,"w":8,"h":8},"targets":[{"expr":"sum(increase(llm_gateway_requests_total{outcome=\"success\"}[30d])) / sum(increase(llm_gateway_requests_total{outcome=~\"success|overloaded|timeout|internal_error\"}[30d]))","legendFormat":"availability"}],"fieldConfig":{"defaults":{"unit":"percentunit"}}},
{"id":2,"type":"stat","title":"TTFT under 300ms (7d)","gridPos":{"x":8,"y":0,"w":8,"h":8},"targets":[{"expr":"sum(increase(llm_gateway_time_to_first_token_seconds_bucket{le=\"0.3\"}[7d])) / sum(increase(llm_gateway_time_to_first_token_seconds_count[7d]))","legendFormat":"compliance"}],"fieldConfig":{"defaults":{"unit":"percentunit"}}},
{"id":3,"type":"stat","title":"Error budget remaining","gridPos":{"x":16,"y":0,"w":8,"h":8},"targets":[{"expr":"1 - ((1 - (sum(increase(llm_gateway_requests_total{outcome=\"success\"}[30d])) / sum(increase(llm_gateway_requests_total{outcome=~\"success|overloaded|timeout|internal_error\"}[30d])))) / 0.001)","legendFormat":"remaining"}],"fieldConfig":{"defaults":{"unit":"percentunit","min":0,"max":1}}},
{"id":4,"type":"timeseries","title":"Availability burn rate","gridPos":{"x":0,"y":8,"w":24,"h":8},"targets":[{"expr":"(1 - sum(rate(llm_gateway_requests_total{outcome=\"success\"}[1h])) / sum(rate(llm_gateway_requests_total{outcome=~\"success|overloaded|timeout|internal_error\"}[1h]))) / 0.001","legendFormat":"1h burn"},{"expr":"(1 - sum(rate(llm_gateway_requests_total{outcome=\"success\"}[6h])) / sum(rate(llm_gateway_requests_total{outcome=~\"success|overloaded|timeout|internal_error\"}[6h]))) / 0.001","legendFormat":"6h burn"}]}]}
