# Image
MULTIWRITE_IMAGE=multiwrite:v1

# Runtime envelope
MULTIWRITE_CPUS=1.0
MULTIWRITE_MEMORY_LIMIT=256m
MULTIWRITE_GOMEMLIMIT=192MiB
MULTIWRITE_ENV=compose
MULTIWRITE_VOLUME_KIND=bind

# Artifact directories
OUTPUT_DIR=./benchmarks/artifacts/outputs
MANIFEST_DIR=./benchmarks/artifacts/manifests
PROFILE_DIR=./benchmarks/artifacts/profiles
TRACE_DIR=./benchmarks/artifacts/traces
SYSCALL_DIR=./benchmarks/artifacts/syscalls

# Smoke workload
SMOKE_WRITER=buffered
SMOKE_PROFILE=tiny
SMOKE_RECORDS=10000
SMOKE_MAX_BYTES=8388608
SMOKE_MAX_DURATION=15s
SMOKE_RECORD_SIZE=8
SMOKE_BUFFER_SIZE=16384
SMOKE_SEED=202
SMOKE_OUTPUT=benchmarks/artifacts/outputs/compose-smoke.txt
SMOKE_MANIFEST=benchmarks/artifacts/manifests/compose-smoke.json
SMOKE_CPU_PROFILE=benchmarks/artifacts/profiles/compose-smoke.cpu.pprof
SMOKE_MEM_PROFILE=benchmarks/artifacts/profiles/compose-smoke.mem.pprof
SMOKE_TRACE=benchmarks/artifacts/traces/compose-smoke.trace

# Comparison workload
BENCH_PROFILE=fixed
BENCH_RECORDS=100000
BENCH_MAX_BYTES=67108864
BENCH_MAX_DURATION=30s
BENCH_RECORD_SIZE=32
BENCH_BUFFER_SIZE=16384
BENCH_SEED=101
BENCH_DIRECT_OUTPUT=benchmarks/artifacts/outputs/compose-direct-fixed.txt
BENCH_DIRECT_MANIFEST=benchmarks/artifacts/manifests/compose-direct-fixed.json
BENCH_BUFFERED_OUTPUT=benchmarks/artifacts/outputs/compose-buffered-fixed.txt
BENCH_BUFFERED_MANIFEST=benchmarks/artifacts/manifests/compose-buffered-fixed.json

# Run policy
DURABILITY=closed
OVERWRITE_POLICY=replace
