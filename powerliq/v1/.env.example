# PowerLiq V1 local-development configuration.
# Copy to .env and provide secrets locally. Never commit a populated .env file.

# Runtime
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
SERVER_SHUTDOWN=graceful
SPRING_LIFECYCLE_TIMEOUT_PER_SHUTDOWN_PHASE=30s
POWERLIQ_PORTFOLIO_ID=10000000-0000-0000-0000-000000000001
POWERLIQ_PORTFOLIO_AVAILABLE_CASH_GBP=250000.00
POWERLIQ_PORTFOLIO_LIQUIDITY_BUFFER_GBP=100000.00

# PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/powerliq
SPRING_DATASOURCE_USERNAME=powerliq
SPRING_DATASOURCE_PASSWORD=powerliq
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=3s

# Elexon HTTP client
POWERLIQ_ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
POWERLIQ_ELEXON_CONNECT_TIMEOUT=3s
POWERLIQ_ELEXON_READ_TIMEOUT=10s
POWERLIQ_ELEXON_MAX_RESPONSE_BYTES=5242880

# Data freshness
POWERLIQ_MARKET_DATA_MAX_AGE=90m

# Local administrative endpoint key. Use a secret manager outside local development.
POWERLIQ_ADMIN_KEY=local-dev-key

# Actuator and observability
MANAGEMENT_SERVER_PORT=8081
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_POWERLIQ=INFO

# JVM container controls. Adjust only after measurement.
JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=70 -XX:InitialRAMPercentage=25 -XX:+ExitOnOutOfMemoryError -Dfile.encoding=UTF-8 -Duser.timezone=UTC"
