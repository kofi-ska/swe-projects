# PowerLiq V2 local operational controls. Copy to .env; never commit real secrets.
# Spring services load .env from their working directory. Docker Compose also loads it.

# Security and event transport (disabled only for local development)
POWERLIQ_SECURITY_ENABLED=false
POWERLIQ_EVENTS_ENABLED=false
POWERLIQ_JWT_ISSUER_URI=
POWERLIQ_EVENT_BUS_NAME=powerliq-local
POWERLIQ_MARKET_PRICE_QUEUE_URL=http://localhost:4566/000000000000/powerliq-market-price
POWERLIQ_AWS_ENDPOINT=http://localhost:4566
POWERLIQ_AWS_REGION=eu-west-2
POWERLIQ_EVENT_PUBLISH_DELAY_MS=1000
POWERLIQ_EVENT_PUBLISH_BATCH_SIZE=10
POWERLIQ_EVENT_MAX_ATTEMPTS=10
POWERLIQ_EVENT_CONSUMER_DELAY_MS=1000
POWERLIQ_EVENT_CONSUMER_BATCH_SIZE=10
POWERLIQ_EVENT_WAIT_SECONDS=10
POWERLIQ_EVENT_VISIBILITY_SECONDS=30

# Shared HTTP lifecycle controls
POWERLIQ_HTTP_CONNECTION_TIMEOUT=3s
POWERLIQ_SHUTDOWN_TIMEOUT=20s

# Position service
POSITION_HTTP_PORT=8081
POSITION_EXPOSE_PORT=8081
POSITION_MEMORY_LIMIT=512m
POSITION_HTTP_THREADS_MAX=50
POSITION_HTTP_THREADS_MIN=5
POSITION_HTTP_ACCEPT_COUNT=50
POSITION_HTTP_MAX_CONNECTIONS=200
POSITION_DB_URL=jdbc:postgresql://localhost:5432/powerliq_position
POSITION_DB_USER=powerliq
POSITION_DB_PASSWORD=change-me
POSITION_DB_POOL_MAX=10
POSITION_DB_POOL_MIN=1
POSITION_DB_CONNECTION_TIMEOUT_MS=2000
POSITION_DB_VALIDATION_TIMEOUT_MS=1000
POSITION_DB_IDLE_TIMEOUT_MS=600000
POSITION_DB_MAX_LIFETIME_MS=1800000

# Portfolio service
PORTFOLIO_HTTP_PORT=8082
PORTFOLIO_HTTP_THREADS_MAX=50
PORTFOLIO_HTTP_THREADS_MIN=5
PORTFOLIO_HTTP_ACCEPT_COUNT=50
PORTFOLIO_DB_URL=jdbc:postgresql://localhost:5432/powerliq_portfolio
PORTFOLIO_DB_USER=powerliq
PORTFOLIO_DB_PASSWORD=change-me
PORTFOLIO_DB_POOL_MAX=10
PORTFOLIO_DB_POOL_MIN=1
PORTFOLIO_DB_CONNECTION_TIMEOUT_MS=2000
PORTFOLIO_DB_VALIDATION_TIMEOUT_MS=1000

# Market ingestion: schedule is UTC; quote this value when exporting in a shell.
INGESTION_HTTP_PORT=8083
INGESTION_HTTP_THREADS_MAX=30
INGESTION_HTTP_THREADS_MIN=3
INGESTION_HTTP_ACCEPT_COUNT=30
INGESTION_DB_URL=jdbc:postgresql://localhost:5432/powerliq_ingestion
INGESTION_DB_USER=powerliq
INGESTION_DB_PASSWORD=change-me
INGESTION_DB_POOL_MAX=8
INGESTION_DB_POOL_MIN=1
INGESTION_DB_CONNECTION_TIMEOUT_MS=2000
INGESTION_DB_VALIDATION_TIMEOUT_MS=1000
INGESTION_CRON=0 2,32 * * * *
INGESTION_MAX_BACKFILL_DAYS=31
INGESTION_DB_RETRY_ATTEMPTS=3
INGESTION_DB_RETRY_BASE_DELAY_MS=25
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_REQUEST_TIMEOUT=10s

# Market data service
MARKET_DATA_HTTP_PORT=8084
MARKET_DATA_EXPOSE_PORT=8084
MARKET_DATA_MEMORY_LIMIT=512m
MARKET_DATA_HTTP_THREADS_MAX=50
MARKET_DATA_HTTP_THREADS_MIN=5
MARKET_DATA_HTTP_ACCEPT_COUNT=50
MARKET_DATA_DB_URL=jdbc:postgresql://localhost:5432/powerliq_market_data
MARKET_DATA_DB_USER=powerliq
MARKET_DATA_DB_PASSWORD=change-me
MARKET_DATA_DB_POOL_MAX=12
MARKET_DATA_DB_POOL_MIN=1
MARKET_DATA_DB_CONNECTION_TIMEOUT_MS=2000
MARKET_DATA_DB_VALIDATION_TIMEOUT_MS=1000

# Valuation service
VALUATION_HTTP_PORT=8085
VALUATION_HTTP_THREADS_MAX=40
VALUATION_HTTP_THREADS_MIN=4
VALUATION_HTTP_ACCEPT_COUNT=40
VALUATION_DB_URL=jdbc:postgresql://localhost:5432/powerliq_valuation
VALUATION_DB_USER=powerliq
VALUATION_DB_PASSWORD=change-me
VALUATION_DB_POOL_MAX=10
VALUATION_DB_POOL_MIN=1
VALUATION_DB_CONNECTION_TIMEOUT_MS=2000
VALUATION_DB_VALIDATION_TIMEOUT_MS=1000

# Local infrastructure bounds
POSTGRES_PORT=5432
POSTGRES_USER=powerliq
POSTGRES_PASSWORD=change-me
POSTGRES_MEMORY_LIMIT=1g
LOCALSTACK_PORT=4566
LOCALSTACK_MEMORY_LIMIT=1g
